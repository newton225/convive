# Bases SQLite de developpement (CLAUDE.md, « Base de donnees ») : une par locataire plus la
# base centrale, regenerees par les migrations et les seeders, jamais des donnees a versionner.
/database/*.sqlite
/database/*.sqlite-*
/database/*.sqlite.bak-*

# Fichiers de marque et preuves deposes en local pendant le developpement (spatie/medialibrary,
# CLAUDE.md « Fichiers de marque ») : hors racine web, et hors depot pour la meme raison que les
# bases SQLite.
/storage/app/tenant-media/*
!/storage/app/tenant-media/.gitignore

# Preuves de paiement (SECURITY.md H1) : disque distinct de tenant-media depuis cette meme
# raison, jamais melange aux fichiers de marque du locataire.
/storage/app/payment-proofs/*
!/storage/app/payment-proofs/.gitignore

# Stockage isole par locataire (FilesystemTenancyBootstrapper, CLAUDE.md « Multi-locataire ») :
# un dossier `storage/tenant{id}/` par organisation, cree localement pendant les tests, jamais a
# committer, meme raison que `/storage/framework`.
/storage/tenant*/

# Etat local de l'outil (verrou de tache planifiee d'une session Claude Code), pas du code du
# projet.
/.claude/

# Tests de bout en bout : l'application de test et les rapports de Playwright.
/storage/e2e/
/playwright-report/
/test-results/
