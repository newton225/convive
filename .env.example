APP_NAME=Convive
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# DomPDF : pur PHP, aucun binaire Chrome/Node requis (voir CLAUDE.md, exports).
LARAVEL_PDF_DRIVER=dompdf

# ---------------------------------------------------------------------------------------------------
# Courriels. Avec `log`, rien ne part : chaque courriel est seulement ecrit dans le journal technique
# (storage/logs). Pour envoyer pour de bon : `smtp` (une boite e-mail, par exemple OVH E-mail Pro) ou
# `resend` (gros volumes, voir RESEND_KEY).
# ---------------------------------------------------------------------------------------------------

# Le service qui envoie : log, smtp ou resend.
# Exemple : MAIL_MAILER=smtp
MAIL_MAILER=log

# Le chiffrement : vide avec le port 587 (la connexion se chiffre d'elle-meme), smtps avec le port 465.
# Exemple : MAIL_SCHEME=
MAIL_SCHEME=null

# Le serveur d'envoi de la boite e-mail (OVH E-mail Pro : celui du webmail, pro1, pro2, pro3...).
# Exemple : MAIL_HOST=pro3.mail.ovh.net
MAIL_HOST=127.0.0.1

# Le port du serveur d'envoi.
# Exemple : MAIL_PORT=587
MAIL_PORT=2525

# L'identifiant : l'adresse e-mail complete.
# Exemple : MAIL_USERNAME=support@devultraapp.com
MAIL_USERNAME=null

# Le mot de passe de cette adresse e-mail. SECRET : ne jamais le partager.
# Exemple : MAIL_PASSWORD=MotDePasseDeLaBoite
MAIL_PASSWORD=null

# L'adresse qui apparait comme expediteur. Avec smtp, la meme que MAIL_USERNAME, sinon le serveur
# refuse ou le courriel finit en indesirables.
# Exemple : MAIL_FROM_ADDRESS="support@devultraapp.com"
MAIL_FROM_ADDRESS="hello@example.com"

# Le nom affiche a cote de l'adresse.
# Exemple : MAIL_FROM_NAME="Convive"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Abonnement des organisations (README section 3) : Stripe. Sans STRIPE_SECRET, l'ecran d'abonnement
# affiche que le paiement en ligne n'est pas disponible. STRIPE_WEBHOOK_SECRET signe les notifications
# entrantes (POST /webhooks/stripe).
STRIPE_SECRET=

# ---------------------------------------------------------------------------------------------------
# WhatsApp. Sans service choisi, ou sans ses identifiants, les messages ne partent pas : ils sont
# seulement ecrits dans le journal technique (storage/logs). Les textes des modeles a faire approuver
# sont dans docs/whatsapp-modeles.md.
# ---------------------------------------------------------------------------------------------------

# Le service qui envoie : twilio (pour commencer), meta (en direct, plus tard), ou vide (journal).
# Exemple : WHATSAPP_DRIVER=twilio
WHATSAPP_DRIVER=

# --- Twilio (si WHATSAPP_DRIVER=twilio) ---

# L'identifiant du compte, sur l'accueil de la console Twilio. Commence par AC.
# Exemple : TWILIO_ACCOUNT_SID=AC0123456789abcdef0123456789abcdef
TWILIO_ACCOUNT_SID=

# Le jeton secret du compte, sur le meme ecran (l'oeil l'affiche). SECRET : ne jamais le partager.
# Exemple : TWILIO_AUTH_TOKEN=0123456789abcdef0123456789abcdef
TWILIO_AUTH_TOKEN=

# Le numero WhatsApp qui envoie, au format international, sans espaces : celui du bac a sable de
# Twilio pour les essais, le votre ensuite.
# Exemple : TWILIO_WHATSAPP_FROM=+17372508034
TWILIO_WHATSAPP_FROM=

# --- Meta en direct (si WHATSAPP_DRIVER=meta) ---

# Le jeton d'acces permanent, cree dans le compte professionnel Meta (Utilisateurs systeme, Generer
# un jeton). SECRET : ne jamais le partager.
# Exemple : WHATSAPP_META_ACCESS_TOKEN=EAAG...
WHATSAPP_META_ACCESS_TOKEN=

# L'identifiant du numero de telephone, affiche dans la configuration WhatsApp de l'app Meta
# (Identifiant du numero de telephone).
# Exemple : WHATSAPP_META_PHONE_NUMBER_ID=109876543210987
WHATSAPP_META_PHONE_NUMBER_ID=

# La langue des modeles approuves chez Meta.
# Exemple : WHATSAPP_META_TEMPLATE_LANGUAGE=fr
WHATSAPP_META_TEMPLATE_LANGUAGE=fr

# --- Modeles approuves (facultatif) ---
# Pour chaque sorte de message : l'identifiant du modele chez Twilio (Content SID, commence par HX)
# ou son nom chez Meta. Vide, le message part en texte libre, ce que WhatsApp n'accepte que dans le
# bac a sable ou dans les 24 heures qui suivent un message de la personne.

# Carte d'invitation, a la confirmation.
# Exemple Twilio : WHATSAPP_TEMPLATE_INVITATION_CARD=HX0123456789abcdef0123456789abcdef
# Exemple Meta   : WHATSAPP_TEMPLATE_INVITATION_CARD=convive_carte_invitation
WHATSAPP_TEMPLATE_INVITATION_CARD=


# Rappel de preuve de paiement (J-7, J-2, J-1).
# Exemple : WHATSAPP_TEMPLATE_PROOF_REMINDER=convive_rappel_preuve
WHATSAPP_TEMPLATE_PROOF_REMINDER=

# Rappel du jour J, trois heures avant.
# Exemple : WHATSAPP_TEMPLATE_TICKET_REMINDER=convive_rappel_jour_j
WHATSAPP_TEMPLATE_TICKET_REMINDER=

# Inscription annulee par l'organisation.
# Exemple : WHATSAPP_TEMPLATE_REGISTRATION_CANCELLED=convive_inscription_annulee
WHATSAPP_TEMPLATE_REGISTRATION_CANCELLED=

# Remboursement envoye.
# Exemple : WHATSAPP_TEMPLATE_REFUND_SENT=convive_remboursement
WHATSAPP_TEMPLATE_REFUND_SENT=

# Alerte aux membres : compte de versement modifie.
# Exemple : WHATSAPP_TEMPLATE_PAYMENT_ACCOUNT_CHANGED=convive_alerte_compte
WHATSAPP_TEMPLATE_PAYMENT_ACCOUNT_CHANGED=

# ---------------------------------------------------------------------------------------------------
# SMS. Sert au seul code de verification du telephone de l'invite (quand l'evenement l'exige, numeros
# ivoiriens seulement). Sans service choisi, ou sans ses identifiants, les SMS ne partent pas : ils
# sont seulement ecrits dans le journal technique (storage/logs).
# ---------------------------------------------------------------------------------------------------

# Le service qui envoie : orange (API SMS d'Orange Cote d'Ivoire), ou vide (journal).
# Exemple : SMS_DRIVER=orange
SMS_DRIVER=

# L'identifiant de l'application, sur developer.orange.com (Mes applications, Client ID).
# Exemple : ORANGE_SMS_CLIENT_ID=AbCdEfGh1234IjKlMnOp5678QrStUvWx
ORANGE_SMS_CLIENT_ID=

# Le secret de l'application, au meme endroit (Client secret). SECRET : ne jamais le partager.
# Exemple : ORANGE_SMS_CLIENT_SECRET=a1B2c3D4e5F6g7H8
ORANGE_SMS_CLIENT_SECRET=

# Le nom d'expediteur affiche sur le telephone, une fois accorde par Orange (11 caracteres au plus).
# Vide : le numero generique d'Orange.
# Exemple : ORANGE_SMS_SENDER_NAME=Convive
ORANGE_SMS_SENDER_NAME=

# ---------------------------------------------------------------------------------------------------
# Protection anti-robot du formulaire d'inscription : Cloudflare Turnstile, gratuit. Sans les deux
# cles, aucune verification n'est demandee aux invites. Cles a creer sur dash.cloudflare.com
# (Turnstile, Ajouter un widget), avec le nom de domaine du site : ses sous-domaines sont couverts.
# En local, les vraies cles refusent les adresses `*.localhost` : utiliser les cles d'essai
# officielles de Cloudflare, toujours acceptees (1x00000000000000000000AA et
# 1x0000000000000000000000000000000AA).
# ---------------------------------------------------------------------------------------------------

# La cle publique du widget (Site Key), affichee dans le formulaire.
# Exemple : TURNSTILE_SITE_KEY=0x4AAAAAAAAbCdEfGhIjKlMn
TURNSTILE_SITE_KEY=

# La cle secrete du widget (Secret Key), pour la verification par le serveur. SECRET : ne jamais
# la partager.
# Exemple : TURNSTILE_SECRET_KEY=0x4AAAAAAAAbCdEfGhIjKlMnOpQrStUvWxYz
TURNSTILE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CONVIVE_BILLING_CURRENCIES=XOF,EUR,USD
CONVIVE_ENFORCE_PLAN_LIMITS=true

# Mesure d'audience (README, « Mesure d'audience ») : identifiant Google Analytics 4 (G-XXXXXXXXXX).
# Vide, rien n'est charge et la CSP reste fermee a Google. Accueil et vitrine seulement, apres
# consentement du visiteur.
GOOGLE_ANALYTICS_ID=

# Securite (SECURITY.md) : proxys reellement places devant l'application, separes par des
# virgules (jamais *), et duree maximale d'une session depuis la connexion, en minutes.
TRUSTED_PROXIES=
SESSION_ABSOLUTE_LIFETIME=720
# Au dela de ce nombre de lignes, un export de la base d'inscrits previent le Proprietaire.
CONVIVE_EXPORT_ALERT_ROWS=200
# Validite d'un billet apres le debut de l'evenement, en heures.
CONVIVE_TICKET_VALID_HOURS_AFTER_START=24

# Rendu serveur Inertia : coupe par defaut en local, actif ailleurs.
INERTIA_SSR_ENABLED=false

# Sauvegardes (config/backup.php). En production : un disque exterieur et un mot de passe d'archive.
BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=

# Adresse prevenue quand une sauvegarde ou un controle de sante echoue (config/health.php).
CONVIVE_ALERT_EMAIL=
# Adresse d'un service exterieur appele a chaque passage du planificateur, pour etre prevenu de son arret.
SCHEDULE_HEARTBEAT_URL=

# Editeur du service et prestataires, repris dans les pages juridiques (config/convive.php, « legal »).
CONVIVE_SUPPORT_EMAIL=
CONVIVE_LEGAL_EDITOR_NAME=
CONVIVE_LEGAL_FORM=
CONVIVE_LEGAL_SHARE_CAPITAL=
CONVIVE_LEGAL_RCCM=
CONVIVE_LEGAL_TAX_NUMBER=
CONVIVE_LEGAL_ADDRESS=
CONVIVE_LEGAL_PUBLICATION_DIRECTOR=
CONVIVE_LEGAL_CONTACT_EMAIL=
CONVIVE_LEGAL_PRIVACY_EMAIL=
CONVIVE_LEGAL_HOST_NAME=
CONVIVE_LEGAL_HOST_ADDRESS=
CONVIVE_LEGAL_MAIL_PROVIDER=
# A passer a true quand un juriste a valide les textes.
CONVIVE_LEGAL_REVIEWED=false
