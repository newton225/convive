# Valeurs de production a reprendre dans le .env du serveur (jamais versionne). Seuls les
# reglages qui different du developpement figurent ici ; les secrets restent a renseigner sur
# place. `php artisan convive:production-check` refuse le deploiement si l'un d'eux manque.
#
# La configuration de base de donnees n'est pas reprise ici : elle ne change que sur decision
# explicite du proprietaire du projet (CLAUDE.md, « Base de donnees »).

APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://convive.example

LOG_LEVEL=warning

SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_ABSOLUTE_LIFETIME=720

# Adresses des proxys ou repartiteurs de charge devant l'application, jamais *.
TRUSTED_PROXIES=

CONVIVE_ENFORCE_TWO_FACTOR=true
CONVIVE_ENFORCE_PLAN_LIMITS=true

# Jamais `log` en production : le journal contiendrait les emails complets, liens signes compris.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=
RESEND_KEY=

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
