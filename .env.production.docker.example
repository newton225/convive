# Reglages propres a la production en conteneurs (docker-compose.prod.yml), a AJOUTER a ceux de
# `.env.production.example` dans le `.env.production` du serveur (jamais versionne). Aucune valeur
# secrete ici.

# --- Base de donnees : PostgreSQL installe sur le serveur ----------------------------------------
# ATTENTION : ne renseigner ces valeurs qu'apres la migration de l'application vers PostgreSQL
# (bases d'organisation aujourd'hui en fichiers SQLite, sauvegardes par copie de fichier). Voir
# docs/conteneurisation.md. Decision du proprietaire du projet : en production, la base est
# PostgreSQL sur le serveur physique.
DB_CONNECTION=pgsql
# `host.docker.internal` designe l'hote depuis les conteneurs (declare dans le compose).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=convive
DB_USERNAME=convive
DB_PASSWORD=
# Le role a besoin de CREATEDB : `stancl/tenancy` cree une base par organisation.

# --- Redis : le service du meme compose -----------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Fichiers et sauvegardes ------------------------------------------------------------------------
# Un stockage exterieur au serveur et un mot de passe d'archive (CLAUDE.md, « Sauvegardes »).
BACKUP_DISK=
BACKUP_ARCHIVE_PASSWORD=
CONVIVE_ALERT_EMAIL=
SCHEDULE_HEARTBEAT_URL=

# Tout le reste (courriel, WhatsApp, Turnstile, identite legale) : voir .env.example.
# `php artisan convive:production-check` dit ce qui manque.
